{
	"name": "rtc-devices-tester",
	"version": "3.1.0",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vite build",
		"serve": "vite preview --host 0.0.0.0",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix --fix-suggestions --fix-dangerously",
		"format": "pnpm lint:fix; oxfmt .",
		"format:check": "oxfmt . --check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"knip": "knip",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip",
		"release": "release-it"
	},
	"dependencies": {
		"@minimalstuff/ui": "^4.0.0",
		"audiomotion-analyzer": "^4.5.4",
		"bowser": "^2.14.1",
		"clsx": "^2.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"store2": "^2.14.4"
	},
	"devDependencies": {
		"@minimalstuff/tooling": "^0.6.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^30.1.2",
		"knip": "^6.41.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"release-it": "^21.1.1",
		"typescript": "~6.0.3",
		"unocss": "^66.11.0",
		"vite": "^8.3.4",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@12.11.2"
}
